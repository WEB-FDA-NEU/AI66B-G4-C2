# ============================================================
#  Tech4Rum — local environment template
#  Copy to .env and fill in the values.  Never commit .env.
# ============================================================

# ─── Option A: separated variables (local / self-hosted Postgres) ───
# This is the primary path.  DB_HOST defaults to localhost and
# DB_PORT to 5432, so for a plain local instance you only need to
# set DB_NAME, DB_USER, and (if it has one) DB_PASSWORD.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tech4rum
DB_USER=postgres
DB_PASSWORD=thgkk2626
# DB_SSLMODE=prefer        # optional — "require", "prefer", "disable"

# ─── Option B: single connection string (managed providers) ───
# If DB_NAME or DB_USER are empty, the backend falls back to
# DATABASE_URL.  This is what Neon, Supabase, Railway, etc. give
# you — paste it here and ignore the block above.
DATABASE_URL=

# ─── JWT ───
JWT_SECRET=doi-chuoi-nay-truoc-khi-deploy
JWT_EXPIRE_MINUTES=60

# ─── CORS ───
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500